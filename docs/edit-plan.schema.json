{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "guards": {
      "additionalProperties": false,
      "properties": {
        "preserve_morphs": {
          "default": true,
          "type": "boolean"
        },
        "preserve_unselected": {
          "default": true,
          "type": "boolean"
        },
        "preserve_uv": {
          "default": true,
          "type": "boolean"
        },
        "preserve_weights": {
          "default": true,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "operations": {
      "items": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "color": {
                "items": {
                  "maximum": 1.0,
                  "minimum": 0.0,
                  "type": "number"
                },
                "maxItems": 4,
                "minItems": 4,
                "type": "array"
              },
              "type": {
                "const": "recolor"
              }
            },
            "required": [
              "type",
              "color"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "anyOf": [
              {
                "required": [
                  "translation"
                ]
              },
              {
                "required": [
                  "scale"
                ]
              },
              {
                "required": [
                  "rotation"
                ]
              }
            ],
            "properties": {
              "pivot": {
                "oneOf": [
                  {
                    "items": {
                      "maximum": 1.0,
                      "minimum": 0.0,
                      "type": "number"
                    },
                    "maxItems": 3,
                    "minItems": 3,
                    "type": "array"
                  },
                  {
                    "enum": [
                      "center",
                      "top-center",
                      "bottom-center"
                    ]
                  }
                ]
              },
              "rotation": {
                "items": {
                  "maximum": 180.0,
                  "minimum": -180.0,
                  "type": "number"
                },
                "maxItems": 3,
                "minItems": 3,
                "type": "array"
              },
              "scale": {
                "items": {
                  "maximum": 20.0,
                  "minimum": 0.05000000074505806,
                  "type": "number"
                },
                "maxItems": 3,
                "minItems": 3,
                "type": "array"
              },
              "translation": {
                "items": {
                  "maximum": 100.0,
                  "minimum": -100.0,
                  "type": "number"
                },
                "maxItems": 3,
                "minItems": 3,
                "type": "array"
              },
              "type": {
                "const": "transform"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "amount"
                ]
              },
              {
                "required": [
                  "strength"
                ]
              }
            ],
            "properties": {
              "amount": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "iterations": {
                "maximum": 3,
                "minimum": 1,
                "type": "integer"
              },
              "strength": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "type": {
                "const": "smooth"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "amount": {
                "maximum": 10,
                "minimum": -10,
                "type": "number"
              },
              "iterations": {
                "maximum": 3,
                "minimum": 1,
                "type": "integer"
              },
              "type": {
                "const": "inflate"
              }
            },
            "required": [
              "type",
              "amount"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "iterations": {
                "maximum": 3,
                "minimum": 1,
                "type": "integer"
              },
              "type": {
                "const": "subdivide"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "color": {
                "items": {
                  "maximum": 1.0,
                  "minimum": 0.0,
                  "type": "number"
                },
                "maxItems": 4,
                "minItems": 4,
                "type": "array"

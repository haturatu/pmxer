                    "type": "string"
                  },
                  "tiers": {
                    "maximum": 4,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "trimColor": {
                    "items": {
                      "maximum": 1.0,
                      "minimum": 0.0,
                      "type": "number"
                    },
                    "maxItems": 4,
                    "minItems": 4,
                    "type": "array"
                  }
                },
                "required": [
                  "style",
                  "trimColor",
                  "accentColor",
                  "tiers",
                  "skirtLength",
                  "sleeveLength",
                  "fullness",
                  "bowSize",
                  "lace"

                "type": "object"
              },
              "replace": {
                "type": "boolean"
              },
              "shape": {
                "enum": [
                  "loafers",
                  "shirt",
                  "skirt",
                  "dress",
                  "pants",
                  "boots",
                  "coat"
                ],
                "type": "string"
              },
              "type": {
                "const": "generate"
              }
            },
            "required": [
              "type",
              "shape",
              "color",
              "replace"
            ],
            "type": "object"
          }
        ]
      },
      "maxItems": 8,
      "minItems": 1,
      "type": "array"
    },
    "preconditions": {
      "additionalProperties": false,
      "properties": {
        "output_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "schema_version": {
      "const": 1
    },
    "selection": {
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "names"
          ]
        },
        {
          "required": [
            "indices"
          ]
        }
      ],
      "properties": {
        "expected_count": {
          "minimum": 1,
          "type": "integer"
        },
        "indices": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "match": {
          "enum": [
            "exact",
            "glob"
          ]
        },
        "names": {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        },
        "type": {
          "const": "material"
        }
      },
      "required": [
        "type",
        "expected_count"
      ],
      "type": "object"

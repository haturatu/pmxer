                    "maxItems": 4,
                    "minItems": 4,
                    "type": "array"
                  },
                  "bowSize": {
                    "maximum": 1.5,
                    "minimum": 0,
                    "type": "number"
                  },
                  "fullness": {
                    "maximum": 1.6,
                    "minimum": 0.6,
                    "type": "number"
                  },
                  "lace": {
                    "type": "boolean"
                  },
                  "skirtLength": {
                    "maximum": 1.5,
                    "minimum": 0.5,
                    "type": "number"
                  },
                  "sleeveLength": {
                    "maximum": 2.1,
                    "minimum": 0,
                    "type": "number"
                  },
                  "style": {
                    "enum": [
                      "plain",
                      "gothic_lolita"
